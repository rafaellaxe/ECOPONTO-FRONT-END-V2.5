# ============================================================
# Configuracao do EcoPonto Frontend
# Copie este arquivo para ".env" e ajuste conforme necessario.
# IMPORTANTE: variaveis VITE_* sao embutidas em tempo de BUILD.
# No Render, defina-as ANTES do build.
# ============================================================

# Modo demo: "true" usa dados simulados (mock) e simula o minigame
# sem precisar de back-end. "false" usa o back-end real.
VITE_USE_MOCK=true

# URL base do back-end FastAPI (sem barra no final).
# Usada apenas quando VITE_USE_MOCK=false.
# Local:      http://localhost:8000
# Producao:   https://sua-api.onrender.com
VITE_API_URL=http://localhost:8000
